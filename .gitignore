# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# Large files — too big for GitHub (kept on HuggingFace Hub instead).
# `outputs/**/<name>` matches at ANY depth — outputs/{model}/[{thinking}/]{deception_prompt}/...
# — so adding new directory levels never leaks these again.
outputs/**/activations.npy
outputs/**/activations_pca*.npy
outputs/**/pca*_components.npy
outputs/**/activations_checkpoint.npz
outputs/**/labels.npy

# Supplement configs (additional_experiment.ipynb) — distinct filenames, same folders
outputs/**/activations_additional_config*.npy
outputs/**/labels_additional_config.npy
outputs/**/activations_additional_config_checkpoint.npz
outputs/**/pca*_components_additional_config.npy

# HuggingFace download cache
.cache/
outputs/**/.cache/

# Probe checkpoints (intermediate pickles, not needed in git) — at any depth
outputs/**/checkpoint_*.pkl

# Per-model data (not in git — too large or model-specific)
# Structure: data/dataset/{model_slug}/{prompt_variant}/responses/
# data/dataset/*/*/responses/*_raw.csv

# Per-model batch files (temporary, generated during judging)
# Structure: data/dataset/{model_slug}/judge/{judge_slug}/batch/
data/dataset/*/judge/*/batch/


# settings.py contains API keys — use settings_template.py instead
utils/settings.py

CLAUDE.md 

reference/*